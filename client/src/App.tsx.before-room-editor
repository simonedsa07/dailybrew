              <div className="panel-heading">
                <div><p className="eyebrow">BREWED WITH LOVE</p><h2>Your very own pixel café</h2></div>
                <span className="bean-chip">{String.fromCodePoint(0x1FAD8)} {beanBalance} beans</span>
              </div>
              <p className="panel-description">A little room to make your own. Pick out something cozy for your café.</p>
              <div className="big-cafe-scene">
                <div className="big-cafe-window">{String.fromCodePoint(0x2601)}<span>✦</span><i>✿</i></div>
                <div className="big-cafe-shelf">📚　🪴　📚</div>
                <div className="big-cafe-counter">🌿　▰ ☕ ▰　🪴</div>
                <div className="big-cafe-floor" />
              </div>
              <h3 className="section-subtitle">A few things for your café</h3>
              {cafeLoading && <p className="small-note">Loading your café shop...</p>}
              {!cafeLoading && cafeItems.length === 0 && <p className="small-note">No café items are available right now. Check that the catalogue has been seeded.</p>}
              <div className="shop-grid">
                {cafeItems.map((item) => (
                  <article className="shop-item" key={item.itemId}>
                    <span>{getCafeItemIcon(item)}</span>
                    <strong>{item.name}</strong>
                    {item.description && <p>{item.description}</p>}
                    <small>{String.fromCodePoint(0x1FAD8)} {item.price} beans</small>
                    <button
                      className="soft-button"
                      disabled={cafeLoading || purchasingItemId !== null || beanBalance < item.price}
                      onClick={() => void handleCafePurchase(item.itemId)}
                    >
                      {purchasingItemId === item.itemId ? "Buying..." : beanBalance < item.price ? "Not enough beans" : "Buy item"}
                    </button>
                  </article>
                ))}
              </div>

              <div className="cafe-inventory-section">
                <div className="cafe-inventory-heading">
                  <div>
                    <h3 className="section-subtitle">My Items</h3>
                    <p className="small-note">Everything you have bought for your little café.</p>
                  </div>
                  <span className="cafe-inventory-count">{ownedCafeItems.length} item types</span>
                </div>
                {ownedCafeItems.length === 0 ? (
                  <div className="cafe-inventory-empty">
                    <span>🧺</span>
                    <p>Your shelves are waiting for their first little treasures.</p>
                    <small>Buy something from the shop above to see it here.</small>
                  </div>
                ) : (
                  <div className="cafe-inventory-grid">
                    {ownedCafeItems.map((ownedItem) => {
                      const item = cafeItems.find((entry) => entry.itemId === ownedItem.itemId)
                      if (!item) return null
                      return (
                        <article className="cafe-inventory-item" key={ownedItem.itemId}>
                          <span className="cafe-inventory-icon">{getCafeItemIcon(item)}</span>
                          <div className="cafe-inventory-details">
                            <strong>{item.name}</strong>
                            <small>{item.category || 'Café item'}</small>
                          </div>
                          <span className="cafe-inventory-quantity">×{ownedItem.quantity}</span>
                        </article>
                      )
                    })}
                  </div>
                )}
                <p className="cafe-inventory-hint">Next up: place your owned items in the room editor.</p>
              </div>
            </section>
          )}{activePage === 'My Profile' && (
            <section className="panel standalone-panel">
              <p className="eyebrow">YOUR LITTLE CORNER</p>
              <h2>My profile ☕</h2>
              <p className="panel-description">A little space that belongs to you.</p>
              <div className="profile-detail-card">
                <span className="avatar profile-large-avatar">{user.name.charAt(0).toUpperCase()}</span>
                <div>
                  <h3>{user.name}</h3>
                  <p>{user.email}</p>
                </div>
              </div>
              <div className="settings-row">
                <span><strong>Account name</strong><small>The name linked to your Daily Brew account.</small></span>
                <strong>{user.name}</strong>
              </div>
              <div className="settings-row">
                <span><strong>Email address</strong><small>Your account login email.</small></span>
                <strong>{user.email}</strong>
              </div>
              <div className="settings-row">
                <span><strong>Café beans</strong><small>Your current bean balance.</small></span>
                <strong>🫘 {beanBalance}</strong>
              </div>
              <button className="soft-button" type="button" onClick={() => setActivePage('Settings')}>
                Open settings →
              </button>
            </section>
          )}

          {activePage === 'Settings' && (
            <section className="panel standalone-panel">
              <p className="eyebrow">YOUR SPACE, YOUR PACE</p><h2>A few little preferences ⚙</h2>
              <p className="panel-description">Personalize your Daily Brew experience.</p>
              <div className="settings-row"><span><strong>Monthly budget</strong><small>Set the amount you want to keep an eye on.</small></span><input aria-label="Monthly budget" type="number" min="0" value={budget} onChange={(event) => setBudget(event.target.value)} /></div>
              <div className="settings-row"><span><strong>Daily water goal</strong><small>How many glasses would feel good today?</small></span><div className="water-control"><button onClick={() => setWater(Math.max(0, water - 1))}>−</button><strong>{water} glasses</strong><button onClick={() => setWater(Math.min(20, water + 1))}>+</button></div></div>
              <div className="settings-row"><span><strong>Your current mood</strong><small>You can change this whenever you like.</small></span><strong>{mood || 'Not checked in yet'}</strong></div>
              <button
  className="auth-submit"
  type="button"
  onClick={handleLogout}
  style={{ marginTop: '20px', width: '100%' }}
>
  Log out
</button>
              <p className="small-note">These preferences are currently held in memory only. Authentication and account persistence are not connected yet.</p>
            </section>
          )}

          {purchaseConfirmation && (
            <div className="purchase-modal-overlay" onClick={() => setPurchaseConfirmation(null)}>
              <section
                className="purchase-modal"
                role="dialog"
                aria-modal="true"
                aria-labelledby="purchase-modal-title"
                onClick={(event) => event.stopPropagation()}
              >
                <button
                  className="purchase-modal-close"
                  type="button"
                  aria-label="Close confirmation"
                  onClick={() => setPurchaseConfirmation(null)}
                >
                  ×
                </button>
                <div className="purchase-modal-icon">☕</div>
                <p className="eyebrow">A LITTLE TREAT FOR YOUR CAFÉ</p>
                <h2 id="purchase-modal-title">Yay! It's yours!</h2>
                <p className="purchase-modal-item">{purchaseConfirmation.name}</p>
                <p className="purchase-modal-message">Your café is getting cozier, one little detail at a time.</p>
                <div className="purchase-modal-summary">
                  <div><span>Beans spent</span><strong>🫘 −{purchaseConfirmation.price}</strong></div>
                  <div><span>Beans remaining</span><strong>🫘 {purchaseConfirmation.balance}</strong></div>
                </div>
                <button
                  className="primary-button purchase-modal-button"
                  type="button"
                  onClick={() => setPurchaseConfirmation(null)}
                >
                  Got it! ♡
                </button>
              </section>
            </div>
          )}

          <footer className="page-footer"><span>Made with a little love and a lot of ☕</span><span>Remember: progress isn't always linear. ♡</span></footer>
        </div>
      </main>
    </div>
  )
}

export default App




