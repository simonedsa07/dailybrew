
import { useState } from 'react'
import './App.css'

type Habit = {
  id: number
  name: string
  detail: string
  icon: string
  done: boolean
  color: string
}

type Expense = {
  id: number
  name: string
  category: string
  amount: number
  icon: string
}

const initialHabits: Habit[] = [
  { id: 1, name: 'Drink some water', detail: '8 glasses', icon: '💧', done: true, color: 'blue' },
  { id: 2, name: 'Read a little', detail: '15 minutes', icon: '📚', done: true, color: 'lavender' },
  { id: 3, name: 'Move your body', detail: 'A little movement', icon: '🌱', done: false, color: 'green' },
  { id: 4, name: 'No-phone break', detail: '10 mindful minutes', icon: '🌷', done: false, color: 'pink' },
]

const initialExpenses: Expense[] = [
  { id: 1, name: 'Iced coffee', category: 'Food & drinks', amount: 140, icon: '☕' },
  { id: 2, name: 'Auto ride', category: 'Transport', amount: 95, icon: '🚌' },
  { id: 3, name: 'Little treat', category: 'Shopping', amount: 220, icon: '🍰' },
]

const moods = [
  { name: 'Lovely', icon: '🥰' },
  { name: 'Good', icon: '😊' },
  { name: 'Okay', icon: '😌' },
  { name: 'Tired', icon: '🥱' },
  { name: 'Low', icon: '🌧️' },
]

const navItems = [
  { name: 'Dashboard', icon: '⌂' },
  { name: 'My habits', icon: '☑' },
  { name: 'Expenses', icon: '◈' },
  { name: 'Daily journal', icon: '▤' },
  { name: 'My café', icon: '☕' },
  { name: 'Settings', icon: '⚙' },
]

function App() {
  const [activePage, setActivePage] = useState('Dashboard')
  const [habits, setHabits] = useState(initialHabits)
  const [expenses, setExpenses] = useState(initialExpenses)
  const [mood, setMood] = useState('')
  const [journal, setJournal] = useState('')
  const [newHabit, setNewHabit] = useState('')
  const [newExpense, setNewExpense] = useState('')
  const [newAmount, setNewAmount] = useState('')
  const [budget, setBudget] = useState('8000')
  const [water, setWater] = useState(3)
  const [notice, setNotice] = useState('')

  const completed = habits.filter((habit) => habit.done).length
  const spent = expenses.reduce((total, expense) => total + expense.amount, 0)
  const budgetAmount = Number(budget) || 0
  const remaining = budgetAmount - spent
  const progress = habits.length ? Math.round((completed / habits.length) * 100) : 0

  function toggleHabit(id: number) {
    setHabits((current) =>
      current.map((habit) =>
        habit.id === id ? { ...habit, done: !habit.done } : habit,
      ),
    )
  }

  function addHabit() {
    if (!newHabit.trim()) return
    setHabits((current) => [
      ...current,
      {
        id: Date.now(),
        name: newHabit.trim(),
        detail: 'One small step',
        icon: '🌼',
        done: false,
        color: 'green',
      },
    ])
    setNewHabit('')
    setNotice('Your new habit is ready 🌱')
  }

  function addExpense() {
    const amount = Number(newAmount)
    if (!newExpense.trim() || !Number.isFinite(amount) || amount <= 0) {
      setNotice('Enter an expense name and a valid amount.')
      return
    }
    setExpenses((current) => [
      { id: Date.now(), name: newExpense.trim(), category: 'Other', amount, icon: '🧾' },
      ...current,
    ])
    setNewExpense('')
    setNewAmount('')
    setNotice('Expense added to your list ☕')
  }

  function deleteExpense(id: number) {
    setExpenses((current) => current.filter((expense) => expense.id !== id))
    setNotice('Expense removed.')
  }

  function pageTitle() {
    if (activePage === 'Dashboard') return 'Your little corner of calm.'
    if (activePage === 'My habits') return 'Small steps still count.'
    if (activePage === 'Expenses') return 'Know where your money goes.'
    if (activePage === 'Daily journal') return 'A little space for you.'
    if (activePage === 'My café') return 'Your café, your cozy rules.'
    return 'Make yourself at home.'
  }

  return (
    <div className="app-shell">
      <aside className="sidebar">
        <button className="brand" onClick={() => setActivePage('Dashboard')}>
          <span className="brand-cup">☕</span>
          <span>
            <strong>daily brew</strong>
            <small>your daily dose of cozy</small>
          </span>
        </button>

        <div className="side-label">YOUR LITTLE WORLD</div>
        <nav className="side-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <button
              key={item.name}
              className={`nav-item ${activePage === item.name ? 'active' : ''}`}
              onClick={() => {
                setActivePage(item.name)
                setNotice('')
              }}
            >
              <span className="nav-icon">{item.icon}</span>
              <span>{item.name}</span>
              {item.name === 'My café' && <span className="nav-sparkle">✦</span>}
            </button>
          ))}
        </nav>

        <div className="sidebar-spacer" />
        <div className="sidebar-cafe">
          <div className="mini-cafe-art" aria-hidden="true">
            <span>☁️</span><span>🪴</span><span>☕</span>
          </div>
          <p className="pixel-label">A GENTLE REMINDER</p>
          <p className="reminder">You don't have to bloom every day.</p>
          <span className="tiny-sparkles">✳ ✦ ✳</span>
        </div>
        <button className="profile-button" onClick={() => setActivePage('Settings')}>
          <span className="avatar">S</span>
          <span className="profile-copy"><strong>My cozy space</strong><small>Little by little ♡</small></span>
          <span className="profile-dots">···</span>
        </button>
      </aside>

      <main className="main-content">
        <header className="topbar">
          <div className="breadcrumb">My space <span>/</span> <strong>{activePage}</strong></div>
          <div className="topbar-right">
            <span className="date-chip">☀ Tuesday, October 20</span>
            <span className="bean-chip">🫘 <strong>120</strong> beans</span>
          </div>
        </header>

        <div className="page-content">
          <section className="welcome-row">
            <div>
              <p className="eyebrow">A FRESH LITTLE START ✿</p>
              <h1>{activePage === 'Dashboard' ? <>A little hello,<br /><span>you lovely human.</span></> : pageTitle()}</h1>
              <p className="welcome-subtitle">
                {activePage === 'Dashboard'
                  ? 'Take a breath, grab a pretend latte, and see how your day is going.'
                  : 'There is no rush. Let’s take it one little step at a time.'}
              </p>
            </div>
            <div className="hero-art" aria-label="Cozy pixel-inspired coffee illustration">
              <div className="art-sun" />
              <span className="art-star star-one">✦</span>
              <span className="art-star star-two">✳</span>
              <span className="art-leaf">🌿</span>
              <div className="art-window"><div className="window-cross" /></div>
              <div className="art-shelf" />
              <div className="art-pot">🪴</div>
              <div className="art-cup"><span>♡</span><i /></div>
              <div className="art-book">▤</div>
            </div>
          </section>

          {notice && (
            <div className="notice" role="status">
              <span>✿</span> {notice}
              <button onClick={() => setNotice('')} aria-label="Dismiss message">×</button>
            </div>
          )}

          {activePage === 'Dashboard' && (
            <>
              <section className="stats-grid">
                <article className="stat-card stat-habits">
                  <div className="stat-top"><span className="stat-icon">🌱</span><span className="stat-tag">TODAY</span></div>
                  <p className="stat-label">Little habits done</p>
                  <div className="stat-number">{completed}<span> / {habits.length}</span></div>
                  <div className="progress-track"><div className="progress-fill sage-fill" style={{ width: `${progress}%` }} /></div>
                  <p className="stat-foot">{progress === 100 ? 'Look at you go! ✨' : 'Every little step counts.'}</p>
                </article>
                <article className="stat-card stat-spending">
                  <div className="stat-top"><span className="stat-icon">🪙</span><span className="stat-tag">THIS MONTH</span></div>
                  <p className="stat-label">Little things spent</p>
                  <div className="stat-number">₹{spent.toLocaleString('en-IN')}</div>
                  <p className="stat-foot">Across {expenses.length} transactions</p>
                </article>
                <article className="stat-card stat-budget">
                  <div className="stat-top"><span className="stat-icon">🐷</span><span className="stat-tag">YOUR BUDGET</span></div>
                  <p className="stat-label">Still in your pocket</p>
                  <div className="stat-number">₹{remaining.toLocaleString('en-IN')}</div>
                  <p className="stat-foot">{remaining >= 0 ? 'You are doing just fine.' : 'You are over your budget.'}</p>
                </article>
                <article className="stat-card stat-beans">
                  <div className="stat-top"><span className="stat-icon">☕</span><span className="stat-tag">CAFÉ WALLET</span></div>
                  <p className="stat-label">Coffee beans</p>
                  <div className="stat-number">120 <span>beans</span></div>
                  <p className="stat-foot">Your next cozy upgrade awaits.</p>
                </article>
              </section>

              <section className="dashboard-grid">
                <article className="panel habits-panel">
                  <div className="panel-heading">
                    <div><p className="eyebrow">YOUR DAILY RITUALS</p><h2>Today's little habits <span>✿</span></h2></div>
                    <button className="text-link" onClick={() => setActivePage('My habits')}>See all ↗</button>
                  </div>
                  <div className="habit-progress-caption"><span>A little progress</span><strong>{completed} of {habits.length}</strong></div>
                  <div className="progress-track wide"><div className="progress-fill sage-fill" style={{ width: `${progress}%` }} /></div>
                  <div className="habit-list">
                    {habits.slice(0, 4).map((habit) => (
                      <button key={habit.id} className={`habit-row ${habit.done ? 'habit-done' : ''}`} onClick={() => toggleHabit(habit.id)}>
                        <span className={`habit-icon ${habit.color}`}>{habit.icon}</span>
                        <span className="habit-copy"><strong>{habit.name}</strong><small>{habit.detail}</small></span>
                        <span className={`habit-check ${habit.done ? 'checked' : ''}`}>{habit.done ? '✓' : ''}</span>
                      </button>
                    ))}
                  </div>
                  <button className="soft-button full-button" onClick={() => setActivePage('My habits')}>＋ Manage my habits</button>
                </article>

                <article className="panel mood-panel">
                  <div className="panel-heading">
                    <div><p className="eyebrow">A MOMENT FOR YOU</p><h2>How's your heart?</h2></div>
                    <span className="heading-doodle">♡</span>
                  </div>
                  <p className="panel-description">There are no wrong answers. Just check in with yourself.</p>
                  <div className="mood-options">
                    {moods.map((item) => (
                      <button key={item.name} className={`mood-option ${mood === item.name ? 'selected' : ''}`} onClick={() => setMood(item.name)} aria-pressed={mood === item.name}>
                        <span>{item.icon}</span><small>{item.name}</small>
                      </button>
                    ))}
                  </div>
                  <label className="field-label" htmlFor="journal-note">A tiny thought for today</label>
                  <textarea id="journal-note" className="journal-input" value={journal} onChange={(event) => setJournal(event.target.value)} placeholder="What's on your mind, sunshine?" rows={3} />
                  <button className="primary-button full-button" onClick={() => setNotice(mood ? `Check-in noted: feeling ${mood.toLowerCase()} ♡ (demo only)` : 'Choose a mood first, then save your check-in.')}>Save my check-in ♡</button>
                </article>

                <article className="panel expenses-panel">
                  <div className="panel-heading">
                    <div><p className="eyebrow">MONEY, GENTLY</p><h2>Recent little spends</h2></div>
                    <button className="text-link" onClick={() => setActivePage('Expenses')}>View all ↗</button>
                  </div>
                  <div className="expense-list">
                    {expenses.slice(0, 3).map((expense) => (
                      <div className="expense-row" key={expense.id}>
                        <span className="expense-icon">{expense.icon}</span>
                        <span className="expense-copy"><strong>{expense.name}</strong><small>{expense.category}</small></span>
                        <strong className="expense-amount">−₹{expense.amount.toLocaleString('en-IN')}</strong>
                      </div>
                    ))}
                  </div>
                  <div className="spending-summary"><span>Spent so far</span><strong>₹{spent.toLocaleString('en-IN')}</strong></div>
                </article>

                <article className="panel cafe-panel">
                  <div className="panel-heading">
                    <div><p className="eyebrow">YOUR HAPPY PLACE</p><h2>The little café</h2></div>
                    <span className="cafe-badge">OPEN ♡</span>
                  </div>
                  <div className="cafe-scene">
                    <div className="cafe-cloud">☁</div>
                    <div className="cafe-window-art"><span>✦</span><span>✿</span></div>
                    <div className="cafe-shelf-art"><span>▥</span><span>🪴</span><span>▥</span></div>
                    <div className="cafe-counter"><span className="counter-plant">🌿</span><span className="counter-machine">▰<small>☕</small></span><span className="counter-cup">☕</span></div>
                    <div className="cafe-floor" />
                  </div>
                  <div className="cafe-bottom"><p><strong>Your cozy corner is waiting.</strong><small>Earn beans and decorate your space.</small></p><button className="round-arrow" onClick={() => setActivePage('My café')} aria-label="Visit your café">↗</button></div>
                </article>
              </section>
            </>
          )}

          {activePage === 'My habits' && (
            <section className="panel standalone-panel">
              <div className="panel-heading"><div><p className="eyebrow">ONE DAY AT A TIME</p><h2>My habit garden 🌷</h2></div><span className="stat-tag">{completed}/{habits.length} DONE</span></div>
              <p className="panel-description">Tap a habit to mark it complete or undo it. Small is still progress.</p>
              <div className="add-row"><input value={newHabit} onChange={(event) => setNewHabit(event.target.value)} onKeyDown={(event) => event.key === 'Enter' && addHabit()} placeholder="Add a little habit..." aria-label="New habit name" /><button className="primary-button" onClick={addHabit}>＋ Add habit</button></div>
              <div className="habit-list full-habit-list">{habits.map((habit) => <button key={habit.id} className={`habit-row ${habit.done ? 'habit-done' : ''}`} onClick={() => toggleHabit(habit.id)}><span className={`habit-icon ${habit.color}`}>{habit.icon}</span><span className="habit-copy"><strong>{habit.name}</strong><small>{habit.detail}</small></span><span className={`habit-check ${habit.done ? 'checked' : ''}`}>{habit.done ? '✓' : ''}</span></button>)}</div>
              <p className="small-note">Your habits currently live in this browser session. Saving them to your account will require the backend connection.</p>
            </section>
          )}

          {activePage === 'Expenses' && (
            <section className="panel standalone-panel">
              <div className="panel-heading"><div><p className="eyebrow">MONEY, GENTLY</p><h2>My little expense book</h2></div><span className="stat-tag">INR · ₹</span></div>
              <div className="expense-total-card"><span>Total listed expenses</span><strong>₹{spent.toLocaleString('en-IN')}</strong><small>Demo transactions · Not bank-connected</small></div>
              <div className="budget-editor"><label htmlFor="budget">Monthly budget (₹)</label><input id="budget" type="number" min="0" value={budget} onChange={(event) => setBudget(event.target.value)} /><span>Remaining: <strong>₹{remaining.toLocaleString('en-IN')}</strong></span></div>
              <h3 className="section-subtitle">Add a little spend</h3>
              <div className="add-row expense-add-row"><input value={newExpense} onChange={(event) => setNewExpense(event.target.value)} placeholder="What did you spend on?" aria-label="Expense description" /><input value={newAmount} onChange={(event) => setNewAmount(event.target.value)} type="number" min="0" step="1" placeholder="Amount ₹" aria-label="Expense amount" /><button className="primary-button" onClick={addExpense}>＋ Add</button></div>
              <div className="expense-list full-expense-list">{expenses.map((expense) => <div className="expense-row" key={expense.id}><span className="expense-icon">{expense.icon}</span><span className="expense-copy"><strong>{expense.name}</strong><small>{expense.category}</small></span><strong className="expense-amount">₹{expense.amount.toLocaleString('en-IN')}</strong><button className="delete-button" onClick={() => deleteExpense(expense.id)} aria-label={`Delete ${expense.name}`}>×</button></div>)}</div>
              <p className="small-note">Sample expenses are shown for layout preview. New entries are temporary and are not yet saved to MongoDB.</p>
            </section>
          )}

          {activePage === 'Daily journal' && (
            <section className="panel standalone-panel journal-page">
              <p className="eyebrow">A SOFT PLACE TO LAND</p><h2>Dear little diary... ✿</h2>
              <p className="panel-description">You don't have to make sense of everything. Just start wherever you are.</p>
              <label className="field-label" htmlFor="journal-page-mood">How are you feeling?</label>
              <div className="mood-options">{moods.map((item) => <button key={item.name} className={`mood-option ${mood === item.name ? 'selected' : ''}`} onClick={() => setMood(item.name)}><span>{item.icon}</span><small>{item.name}</small></button>)}</div>
              <label className="field-label" htmlFor="journal-page-note">What's on your mind today?</label>
              <textarea id="journal-page-note" className="journal-input journal-big" value={journal} onChange={(event) => setJournal(event.target.value)} placeholder="Write about the little things, the big feelings, or absolutely nothing in particular..." />
              <button className="primary-button" onClick={() => setNotice('Your entry is in this session for now. Backend saving is not connected yet. ♡')}>Keep this little moment ♡</button>
            </section>
          )}

          {activePage === 'My café' && (
            <section className="panel standalone-panel">
              <div className="panel-heading"><div><p className="eyebrow">BREWED WITH LOVE</p><h2>Your very own pixel café ☕</h2></div><span className="bean-chip">🫘 120 beans</span></div>
              <p className="panel-description">A little room to make your own. Your decorations will become persistent once the backend is connected.</p>
              <div className="big-cafe-scene"><div className="big-cafe-window">☁️<span>✦</span><i>✿</i></div><div className="big-cafe-shelf">📚　🪴　📚</div><div className="big-cafe-counter">🌿　▰ ☕ ▰　🪴</div><div className="big-cafe-floor" /></div>
              <h3 className="section-subtitle">A few things for your café</h3>
              <div className="shop-grid">{[{ icon: '🪴', name: 'Happy little plant', price: 30 }, { icon: '💡', name: 'Warm lamp', price: 45 }, { icon: '📚', name: 'Book stack', price: 25 }, { icon: '🪑', name: 'Cozy chair', price: 60 }].map((item) => <article className="shop-item" key={item.name}><span>{item.icon}</span><strong>{item.name}</strong><small>🫘 {item.price} beans</small><button className="soft-button" onClick={() => setNotice(`${item.name} is a shop preview. Real purchases need backend integration.`)}>Peek at item</button></article>)}</div>
            </section>
          )}

          {activePage === 'Settings' && (
            <section className="panel standalone-panel">
              <p className="eyebrow">YOUR SPACE, YOUR PACE</p><h2>A few little preferences ⚙</h2>
              <p className="panel-description">Personalize your Daily Brew experience.</p>
              <div className="settings-row"><span><strong>Monthly budget</strong><small>Set the amount you want to keep an eye on.</small></span><input aria-label="Monthly budget" type="number" min="0" value={budget} onChange={(event) => setBudget(event.target.value)} /></div>
              <div className="settings-row"><span><strong>Daily water goal</strong><small>How many glasses would feel good today?</small></span><div className="water-control"><button onClick={() => setWater(Math.max(0, water - 1))}>−</button><strong>{water} glasses</strong><button onClick={() => setWater(Math.min(20, water + 1))}>＋</button></div></div>
              <div className="settings-row"><span><strong>Your current mood</strong><small>You can change this whenever you like.</small></span><strong>{mood || 'Not checked in yet'}</strong></div>
              <p className="small-note">These preferences are currently held in memory only. Authentication and account persistence are not connected yet.</p>
            </section>
          )}

          <footer className="page-footer"><span>Made with a little love and a lot of ☕</span><span>Remember: progress isn't always linear. ♡</span></footer>
        </div>
      </main>
    </div>
  )
}

export default App
